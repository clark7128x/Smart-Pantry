<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.smartpantry.controllers.MainController"
            style="-fx-background-color: #f5f6fa;">

    <!-- Left Sidebar -->
    <left>
        <VBox prefWidth="250" spacing="0"
              style="-fx-background-color: linear-gradient(to bottom, #2c3e50, #34495e);">

            <!-- App Logo/Title -->
            <VBox alignment="CENTER" spacing="5"
                  style="-fx-background-color: rgba(0,0,0,0.1); -fx-padding: 20;">
                <Label text="🥗" style="-fx-font-size: 48px;"/>
                <Label text="Smart Pantry"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: white;"/>
                <Label text="Kitchen Manager"
                       style="-fx-font-size: 12px; -fx-text-fill: #bdc3c7;"/>
            </VBox>

            <Separator/>

            <!-- Navigation Buttons -->
            <VBox fx:id="navButtons" spacing="5" style="-fx-padding: 20 15;">

                <Button fx:id="btnPantry"
                        text="🏠  My Pantry"
                        onAction="#handlePantryClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1;
                               -fx-font-size: 15px; -fx-padding: 15 20; -fx-cursor: hand;
                               -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;"/>

                <Button fx:id="btnRecipes"
                        text="📖  Recipes"
                        onAction="#handleRecipesClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1;
                               -fx-font-size: 15px; -fx-padding: 15 20; -fx-cursor: hand;
                               -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;"/>

                <Button fx:id="btnWhatToCook"
                        text="🍳  What to Cook?"
                        onAction="#handleWhatToCookClick"
                        maxWidth="Infinity"
                        style="-fx-background-color: transparent; -fx-text-fill: #ecf0f1;
                               -fx-font-size: 15px; -fx-padding: 15 20; -fx-cursor: hand;
                               -fx-background-radius: 8; -fx-alignment: CENTER_LEFT;"/>
            </VBox>

            <!-- Spacer -->
            <Region VBox.vgrow="ALWAYS"/>

            <!-- Footer -->
            <VBox alignment="CENTER" spacing="5" style="-fx-padding: 15;">
                <Separator/>
                <Label fx:id="lblDate" style="-fx-text-fill: #bdc3c7; -fx-font-size: 12px;"/>
                <Label text="v1.0.0" style="-fx-text-fill: #7f8c8d; -fx-font-size: 11px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- Main Content Area -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-padding: 20; -fx-background-color: #f5f6fa;">
        </StackPane>
    </center>

</BorderPane>