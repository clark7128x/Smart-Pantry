<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.smartpantry.controllers.PantryController"
      spacing="20"
      style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 20;">

    <!-- Header Section -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox>
            <Label text="🏠 My Pantry"
                   style="-fx-font-size: 28px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
            <Label text="Manage your kitchen inventory"
                   style="-fx-font-size: 14px; -fx-text-fill: #7f8c8d;"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>

        <!-- Statistics Cards -->
        <HBox spacing="15">
            <VBox alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-padding: 15 25; -fx-border-color: #dcdde1;
                         -fx-border-radius: 10; -fx-border-width: 1;">
                <Label fx:id="lblTotalItems" text="0"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Total Items"
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            </VBox>
            <VBox alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-padding: 15 25; -fx-border-color: #f39c12;
                         -fx-border-radius: 10; -fx-border-width: 2;">
                <Label fx:id="lblExpiringItems" text="0"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Expiring Soon"
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            </VBox>
            <VBox alignment="CENTER"
                  style="-fx-background-color: white; -fx-background-radius: 10;
                         -fx-padding: 15 25; -fx-border-color: #e74c3c;
                         -fx-border-radius: 10; -fx-border-width: 2;">
                <Label fx:id="lblExpiredItems" text="0"
                       style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #2c3e50;"/>
                <Label text="Expired"
                       style="-fx-font-size: 12px; -fx-text-fill: #7f8c8d;"/>
            </VBox>
        </HBox>
    </HBox>

    <Separator/>

    <!-- Add Product Form -->
    <TitledPane text="➕ Add New Product" collapsible="true" expanded="true">
        <GridPane hgap="15" vgap="15" style="-fx-padding: 15;">

            <Label text="Product Name:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtName" promptText="Enter product name"
                       prefWidth="200"
                       GridPane.columnIndex="1" GridPane.rowIndex="0"/>

            <Label text="Quantity:" GridPane.columnIndex="2" GridPane.rowIndex="0"/>
            <TextField fx:id="txtQuantity" promptText="0.00"
                       prefWidth="100"
                       GridPane.columnIndex="3" GridPane.rowIndex="0"/>

            <Label text="Unit:" GridPane.columnIndex="4" GridPane.rowIndex="0"/>
            <ComboBox fx:id="cmbUnit" prefWidth="120"
                      GridPane.columnIndex="5" GridPane.rowIndex="0"/>

            <Label text="Expiration Date:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <DatePicker fx:id="dpExpiration" prefWidth="150"
                        GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <HBox spacing="10" GridPane.columnIndex="2" GridPane.rowIndex="1"
                  GridPane.columnSpan="4">
                <Button text="Add Product" onAction="#handleAddProduct"
                        style="-fx-background-color: #3498db; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 10 20;
                               -fx-background-radius: 6; -fx-cursor: hand;"/>
                <Button text="Clear" onAction="#clearForm"
                        style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                               -fx-font-weight: bold; -fx-padding: 10 20;
                               -fx-background-radius: 6; -fx-cursor: hand;"/>
            </HBox>
        </GridPane>
    </TitledPane>

    <!-- Search and Actions Bar -->
    <HBox spacing="15" alignment="CENTER_LEFT">
        <TextField fx:id="txtSearch" promptText="🔍 Search products..."
                   prefWidth="300"
                   style="-fx-background-color: white; -fx-border-color: #dcdde1;
                          -fx-border-radius: 20; -fx-background-radius: 20;
                          -fx-padding: 10 20;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="🔄 Refresh" onAction="#handleRefresh"
                style="-fx-background-color: #95a5a6; -fx-text-fill: white;
                       -fx-font-weight: bold; -fx-padding: 10 20;
                       -fx-background-radius: 6; -fx-cursor: hand;"/>
    </HBox>

    <!-- Products Table -->
    <TableView fx:id="productTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-border-color: #dcdde1;
                      -fx-border-radius: 8;">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="60"/>
            <TableColumn fx:id="colName" text="Product Name" prefWidth="200"/>
            <TableColumn fx:id="colQuantity" text="Quantity" prefWidth="100"/>
            <TableColumn fx:id="colUnit" text="Unit" prefWidth="100"/>
            <TableColumn fx:id="colExpiration" text="Expiration Date" prefWidth="150"/>
            <TableColumn fx:id="colActions" text="Actions" prefWidth="180"/>
        </columns>
        <placeholder>
            <Label text="No products in your pantry. Add some above!"
                   style="-fx-text-fill: #7f8c8d; -fx-font-style: italic;"/>
        </placeholder>
    </TableView>

    <!-- Legend -->
    <HBox spacing="20" alignment="CENTER_LEFT" style="-fx-padding: 10 0;">
        <HBox spacing="5" alignment="CENTER_LEFT">
            <Region prefWidth="20" prefHeight="20"
                    style="-fx-background-color: rgba(231, 76, 60, 0.5); -fx-background-radius: 4;"/>
            <Label text="Expired"/>
        </HBox>
        <HBox spacing="5" alignment="CENTER_LEFT">
            <Region prefWidth="20" prefHeight="20"
                    style="-fx-background-color: rgba(243, 156, 18, 0.5); -fx-background-radius: 4;"/>
            <Label text="Expiring within 2 days"/>
        </HBox>
    </HBox>

</VBox>